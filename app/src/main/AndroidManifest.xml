<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The SDK calls the Ulinkly API (bootstrap, link resolution, sessions) and
         watches connectivity to retry when the device comes back online. Declared
         here so they merge into every host app; without them init can never
         reach the server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
